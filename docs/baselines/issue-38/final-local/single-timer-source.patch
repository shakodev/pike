+
+fn end_timer(seconds: u64) -> Task<Msg> {
+    Task::perform(
+        async move {
+            let armed = Instant::now();
+            tokio::time::sleep(Duration::from_secs(seconds)).await;
+            (armed, Instant::now())
+        },
+        |(armed, woke)| Msg::TimedEnd(armed, woke),
+    )
